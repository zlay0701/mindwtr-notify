# Notify - local config template
# Copy this file to .env and fill MINDWTR_TOKEN. .env stays on your machine;
# do not commit it, paste it into chat, or include it in logs/reports.
# The probe reads it automatically and issues GET requests only.

MINDWTR_BASE_URL=https://mindwtr-cloud-instabox.zlay.dpdns.org

# A FULL bearer token is required. Capture-only tokens are limited to
# POST /v1/capture and return 403 on /v1/tasks, /v1/projects, etc.
MINDWTR_TOKEN=

# ---- 全局 ----
# 进程时区（容器运行时生效）：决定「不带时区」的日期字符串（如 2026-11-16T10:11）按哪个时区解析。
# 必须与 NOTIFY_TIMEZONE 保持一致；镜像默认 UTC，不设会让提醒晚 8 小时。
# 下面这行刻意不带行尾注释：本项目的 .env 解析器不剥离注释，加了会把注释当成时区值。
TZ=Asia/Shanghai
NOTIFY_TIMEZONE=Asia/Shanghai          # 摘要/静默时段按这个时区判定
# 消息里时间的显示格式（只影响邮件正文与钉钉/企微/飞书文本；结构化 JSON 仍是 ISO 8601）。
# token：yyyy MM dd HH mm ss，例如 yyyy/MM/dd HH:mm；一个 token 都没有会回退默认值。
# 本行不要加行尾注释：.env 解析器不剥离注释。
NOTIFY_TIME_FORMAT=yyyy-MM-dd HH:mm:ss
NOTIFY_STRICT=false                   # true = 强制关闭全部 A 类扩展，用于一致性验收
NOTIFY_POLL_SECONDS=60                # 官方桌面端 15s；设 15 可完全对齐
NOTIFY_GRACE_MS=300000                # 补发窗口 5 分钟，对齐官方 MAX_CATCH_UP_MS
NOTIFY_CATCH_UP=true                  # false = 过去时刻的触发点一律不补发
NOTIFY_STATE_PATH=data/notify.sqlite
HEALTHZ_PORT=8788
HEALTHZ_TOKEN=                        # 非空时 /healthz 需要 Bearer 鉴权
# EXT-20 日志级别：debug | info | warn | error | silent，默认 info（日常运行）
# 临时排障可用 --log-level=debug 覆盖，不必改本文件；值行请保持干净、不要在后面加注释
NOTIFY_LOG_LEVEL=info

# ---- 与官方一致的全局设置（BASE-17 / BASE-20 / BASE-26）----
# 任务级提前量、重复间隔、发送策略不在这里配，直接读任务字段。
NOTIFY_TASK_REMINDER_DEFAULT=send
NOTIFY_INCLUDE_START=true
NOTIFY_INCLUDE_DUE=true
NOTIFY_INCLUDE_REVIEW=true
NOTIFY_INCLUDE_REFERENCE=false
NOTIFY_DIGEST_MORNING=true
NOTIFY_DIGEST_EVENING=true
NOTIFY_DIGEST_WEEKLY=true
NOTIFY_DIGEST_WITHOUT_DESCRIPTION=true # EXT-03 摘要不含任务描述，减小外发内容

# ---- A 类扩展（官方没有，默认全部关闭，开启后才改变触发计划）----
NOTIFY_DATE_ONLY=false                # EXT-16 仅日期任务当日 09:00 汇总
NOTIFY_BACKLOG=false                  # EXT-17 启动时的积压逾期清单
NOTIFY_QUIET_HOURS=false              # EXT-18 静默时段顺延

# ---- 可靠性（EXT-11）----
NOTIFY_FAILURE_ALERT_AFTER=3
NOTIFY_MAX_BACKOFF_MS=600000

# ---- 邮件通道（EXT-01）----
SMTP_ENABLED=false
SMTP_HOST=
# 端口语义：587 = STARTTLS；465 = 隐式 TLS（代码按端口自动判断，没有独立开关）。
# 若 VPS 出站 25/465/587 被拒（目标 VPS 已实测），Resend 的备选端口是 2587（STARTTLS），改成 2587 即可；
# 2465 是隐式 TLS，当前代码只在 SMTP_PORT=465 时启用隐式 TLS，所以不要用 2465。
# 下面这行不要加行尾注释：本项目的 .env 解析器不剥离注释。
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Notify
SMTP_TO=                             # 多个收件人用逗号分隔

# ---- Webhook 通道（EXT-04 / EXT-05）----
WEBHOOK_ENABLED=false
WEBHOOK_URLS=                        # 多个 URL 用逗号分隔
WEBHOOK_SECRET=                      # HMAC-SHA256 密钥，用于 X-Notify-Signature
WEBHOOK_MAX_ATTEMPTS=3

# ---- M3 平台适配器（【官方无】，默认 generic）----
# 所有已配置渠道默认一起发送，不做标签过滤
# 平台适配器：与 WEBHOOK_URLS 一一对应，可选 generic/dingtalk/wecom/feishu
# 例：WEBHOOK_URLS=钉钉URL,企微URL,飞书URL
#     NOTIFY_WEBHOOK_ADAPTERS=dingtalk,wecom,feishu
#     NOTIFY_WEBHOOK_SECRETS=钉钉加签密钥,,飞书签名密钥
NOTIFY_WEBHOOK_ADAPTERS=
NOTIFY_WEBHOOK_SECRETS=

# ---- M4 管理页与多命名空间（EXT-19 后半【官方无】，不产生任何触发点）----
# 命名空间：同一台机器跑多套实例时，配置 / 状态库 / 去重键按它隔离。
# 默认 default 与 M1–M3 完全兼容；非默认会自动派生 data/notify-<ns>.sqlite。
NOTIFY_NAMESPACE=default
# 可选 JSON 配置文件里可写 {"namespaces":{"work":{"NOTIFY_TIMEZONE":"..."}}} 按段覆盖配置。
NOTIFY_CONFIG=
NOTIFY_ADMIN_PAGE=true              # 挂载 GET /admin 只读页面（与 /healthz 共用端口）
NOTIFY_ADMIN_TOKEN=                 # 管理接口鉴权；留空则回退 HEALTHZ_TOKEN
NOTIFY_ADMIN_RETRY=false           # 手动重发总开关：true + 有效 token 才会放行
NOTIFY_ADMIN_MAX_RECORDS=100       # 管理页每个列表最多返回多少条

